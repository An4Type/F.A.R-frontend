{
    "name": "an4type",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "start:dev": "NODE_ENV=development expo start",
        "start:prod": "NODE_ENV=production expo start",
        "android:dev": "NODE_ENV=development expo start --android",
        "ios:dev": "NODE_ENV=development NODE_OPTIONS=\"--dns-result-order=ipv4first\" npx expo start --ios --offline",
        "web:dev": "NODE_ENV=development expo start --web",
        "android:prod": "NODE_ENV=production expo start --android",
        "ios:prod": "NODE_ENV=production expo start --ios",
        "web:prod": "NODE_ENV=production expo start --web",
        "test": "jest --watchAll=false",
        "lint": "expo lint",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "commit:lint": "commitlint --from HEAD~1 --to HEAD --verbose",
        "release": "standard-version",
        "release:dry": "standard-version --dry-run"
    },
    "jest": {
        "preset": "jest-expo"
    },
    "dependencies": {
        "@expo-google-fonts/inter": "^0.4.2",
        "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
        "@expo/vector-icons": "^15.0.2",
        "@hookform/resolvers": "^5.9.1",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@tanstack/react-query": "^5.101.2",
        "axios": "^1.7.9",
        "expo": "~57.0.27",
        "expo-asset": "~57.0.19",
        "expo-blur": "~57.0.3",
        "expo-build-properties": "~57.0.22",
        "expo-camera": "~57.0.6",
        "expo-constants": "~57.0.21",
        "expo-font": "~57.0.4",
        "expo-image-picker": "~57.0.20",
        "expo-linear-gradient": "~57.0.2",
        "expo-linking": "~57.0.12",
        "expo-router": "~57.0.25",
        "expo-splash-screen": "~57.0.9",
        "expo-status-bar": "~57.0.1",
        "expo-system-ui": "~57.0.4",
        "expo-web-browser": "~57.0.3",
        "form-data": "^4.0.1",
        "nativewind": "^4.2.7",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-hook-form": "^7.89.0",
        "react-native": "0.86.3",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-svg": "15.15.4",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "0.10.1",
        "tailwindcss": "^3.4.19",
        "zod": "^4.6.5",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@commitlint/cli": "^21.2.0",
        "@commitlint/config-conventional": "^21.2.0",
        "@react-native/jest-preset": "^0.86.3",
        "@types/jest": "^29.5.12",
        "@types/react": "~19.2.4",
        "eslint": "^8.57.1",
        "eslint-config-expo": "~57.0.2",
        "eslint-config-prettier": "^10.1.8",
        "git-conventional-commits": "^2.9.0",
        "husky": "^9.1.7",
        "jest": "~29.7.0",
        "jest-expo": "~57.0.5",
        "prettier": "^3.9.4",
        "standard-version": "^9.5.0",
        "typescript": "~6.0.3"
