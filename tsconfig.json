{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "esModuleInterop": true,
        "strict": true,
        "types": ["jest"],
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "nativewind-env.d.ts"
    ]
}
